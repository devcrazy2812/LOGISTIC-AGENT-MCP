# LogiSwarm AI - Environment Configuration Example
# IMPORTANT: All secrets stay on the backend server and are NEVER exposed to the client-side browser!

# (Optional) LLM API Key: Supports Google Gemini (AIza...) or Groq (gsk_...)
# If left empty, the application runs on its embedded deterministic reasoning engine.
GEMINI_API_KEY=your_gemini_or_groq_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Master HMAC-SHA256 Secret Key
LOGISWARM_SECRET_KEY=your_32_byte_secret_key_here

# Server Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=production
