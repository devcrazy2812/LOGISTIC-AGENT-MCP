# LogiSwarm AI - Environment Configuration
# IMPORTANT: All secrets stay on the backend server and are NEVER exposed to the client-side browser!

# (Optional) Google Gemini API Key for Live Multimodal Vision & Dialogue
# If left empty, the application runs on its embedded offline reasoning engine.
GEMINI_API_KEY=your_google_gemini_api_key_here

# Server Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=production
